#!/usr/bin/env bash
# Control the System76 4-zone RGB keyboard (system76_acpi driver). Run with no arguments for
# status, or -h for usage. color, zones, cycle, rainbow, and pulse go to the kbd-rgb daemon,
# which checks them and runs the fades; without the daemon, only plain colors (color, zones),
# brightness, and status work.
set -euo pipefail
D=${KBDRGB_LED:-/sys/class/leds/system76::kbd_backlight}
SOCKET=${KBDRGB_SOCKET:-/run/kbd-rgb/socket}
ZONE_NAMES=(left center right extra)

usage() {
  cat <<'EOF'
Usage: kbdrgb COMMAND [ARGS] [OPTIONS]
  color RRGGBB         set a color
  zones L C R E        set each zone's color or effect (left, center, right, numpad),
                       each as the color dialog takes it: 00FF00, 00FF00,0000FF (a cycle),
                       pulse,00FFAA, rainbow, "00FF00 0000FF 2" (2 seconds per color)
  cycle C1 C2 [...]    fade between 2 to 16 colors, over and over
  rainbow              fade through the hues, each zone a step around the wheel from the last
  pulse RRGGBB         fade between a color and a dim copy of it
  brightness 0-255     backlight brightness (whole keyboard)
  status               show the brightness, each zone's color or effect, and a zones command
                       that sets them all again (the default)

Options:
  -z, --zone ZONE      left, center, right, extra (numpad), or all (the default)
                       for color, cycle, rainbow, pulse
  -t, --time SECONDS   seconds to fade from one color to the next
                       color, zones: default 0 (at once); cycle: 1; rainbow: 0.6; pulse: 0.5
  -d, --for SECONDS    for cycle, rainbow, pulse: stop after this long, keeping the last frame
  -e, --ease EASE      how each fade speeds up and slows down: linear (the default), ease,
                       ease-in, ease-out, ease-in-out, or a cubic bezier X1,Y1,X2,Y2 (each 0-1)

For color, zones, and cycle, a color can have its own curve for fading into it, which takes
the place of --ease for that step: kbdrgb cycle FF0000 FFFF00:ease-in 0000FF:0.9,0,0.1,1

Effects run until their zone gets a new color, and each zone keeps its own effect and time.
Effects with the same colors and --time stay in step, however far apart you start them.
EOF
}

die() { echo "kbdrgb: $*" >&2; exit 1; }
NEED_DAEMON="the kbd-rgb daemon isn't running (sudo systemctl start kbd-rgb)"

# send ARGS...: run "kbdrgb ARGS..." in the daemon, which checks it and answers "ok" or what's
# wrong; lines after "ok" (status's) are printed. Each argument goes with a NUL after it. Returns 1 if the daemon isn't running. Bash
# can't open a Unix socket itself, so the Python the daemon runs on (/usr/bin/python3) does.
SEND_PY='
import os, socket, sys
try:
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(2)
        s.connect(sys.argv[1])
        s.sendall(b"".join(os.fsencode(a) + b"\0" for a in sys.argv[2:]))
        s.shutdown(socket.SHUT_WR)
        reply = b""
        while chunk := s.recv(4096):
            reply += chunk
except OSError:
    sys.exit(1)
sys.stdout.write(reply.decode(errors="replace"))
'
send() {
  [[ -S $SOCKET && -w $SOCKET ]] || return 1
  local reply
  reply=$(/usr/bin/python3 -I -c "$SEND_PY" "$SOCKET" "$@" 2>/dev/null) || return 1
  [[ ${reply%%$'\n'*} == ok ]] || die "${reply:-no answer from the kbd-rgb daemon}"
  [[ $reply != *$'\n'* ]] || printf '%s\n' "${reply#*$'\n'}"
}

hex() { [[ $1 =~ ^#?[0-9A-Fa-f]{6}$ ]] || die "bad color: $1"; echo "${1#\#}" | tr a-f A-F; }

# offline color|zones ARGS...: without the daemon, write plain colors straight to the LEDs.
# Only colors and (for color) --zone; every color is checked before any is written.
offline() {
  local what=$1 zone=all cs=() c z
  shift
  while (( $# )); do
    case $1 in
      -z|--zone) [[ $what == color ]] && (( $# >= 2 )) || die "$NEED_DAEMON"; zone=$2; shift 2 ;;
      --zone=*)  [[ $what == color ]] || die "$NEED_DAEMON"; zone=${1#*=}; shift ;;
      -*|*:*)    die "$what $1: $NEED_DAEMON" ;;
      *)         [[ $what == zones && ( $1 == *[,\ ]* || ${1,,} == rainbow ) ]] && die "$what $1: $NEED_DAEMON"
                 c=$(hex "$1") || exit 1; cs+=("$c"); shift ;;
    esac
  done
  if [[ $what == color ]]; then
    (( ${#cs[@]} == 1 )) || die "color takes one color"
    case $zone in
      all) for z in "${ZONE_NAMES[@]}"; do w "color_$z" "${cs[0]}"; done ;;
      left|center|right|extra) w "color_$zone" "${cs[0]}" ;;
      *) die "bad zone: $zone (left, center, right, extra, or all)" ;;
    esac
  else
    (( ${#cs[@]} >= 1 && ${#cs[@]} <= 4 )) || die "zones takes 1 to 4 colors"
    for z in 0 1 2 3; do w "color_${ZONE_NAMES[$z]}" "${cs[$z]:-FFFFFF}"; done
  fi
}

w() { printf '%s' "$2" > "$D/$1"; }

cmd=${1:-status}
(( $# )) && shift
for a in "$cmd" "$@"; do
  case $a in -h|--help|help) usage; exit 0 ;; esac
done

case $cmd in
  color|zones)
    send "$cmd" "$@" || offline "$cmd" "$@" ;;
  cycle|rainbow|pulse)
    send "$cmd" "$@" || die "$cmd needs the daemon: $NEED_DAEMON" ;;
  brightness)
    (( $# == 1 )) && [[ $1 =~ ^[0-9]{1,3}$ ]] && (( 10#$1 <= 255 )) || die "brightness takes a number from 0 to 255"
    w brightness "$(( 10#$1 ))" ;;
  status)
    (( $# == 0 )) || die "status takes no arguments"
    send status && exit
    # Without the daemon: the colors on the LEDs now.
    echo "brightness: $(cat "$D/brightness")"
    cs=()
    for z in "${ZONE_NAMES[@]}"; do cs+=("$(cat "$D/color_$z")"); printf '%-8s%s\n' "$z:" "${cs[-1]}"; done
    echo "kbdrgb zones ${cs[*]}" ;;
  *) die "unknown command: $cmd (kbdrgb -h for usage)" ;;
esac
