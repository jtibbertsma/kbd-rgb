#!/usr/bin/env bash
# Control the System76 4-zone RGB keyboard (system76_acpi driver). Run with no arguments for
# status, or -h for usage. Commands go to the kbd-rgb daemon, which runs the fades; without
# the daemon, only instant colors, brightness, and status work.
set -euo pipefail
D=${KBDRGB_LED:-/sys/class/leds/system76::kbd_backlight}
NOTIFY=${KBDRGB_NOTIFY:-/run/kbd-rgb/notify}
ZONE_NAMES=(left center right extra)

usage() {
  cat <<'EOF'
Usage: kbdrgb COMMAND [ARGS] [OPTIONS]
  color RRGGBB         set a color
  zones L C R E        set each zone's color (left, center, right, numpad)
  cycle C1 C2 [...]    fade between 2 to 16 colors, over and over
  rainbow              fade through the hues, each zone a step around the wheel from the last
  pulse RRGGBB         fade between a color and a dim copy of it
  brightness 0-255     backlight brightness (whole keyboard)
  status               show brightness and zone colors (the default)

Options:
  -z, --zone ZONE      left, center, right, extra (numpad), or all (the default)
                       for color, cycle, rainbow, pulse
  -t, --time SECONDS   seconds to fade from one color to the next
                       color, zones: default 0 (at once); cycle: 1; rainbow: 0.6; pulse: 0.5
  -d, --for SECONDS    for cycle, rainbow, pulse: stop after this long, keeping the last frame

Effects run until their zone gets a new color, and each zone keeps its own effect and time.
Effects with the same colors and --time stay in step, however far apart you start them.
EOF
}

die() { echo "kbdrgb: $*" >&2; exit 1; }

# Send lines to the daemon. Opening the pipe for writing waits for a reader, which the daemon
# always is; if nothing opens it within half a second, the daemon isn't running. Returns 1
# then, or if the pipe isn't there.
send() {
  [[ -p $NOTIFY && -w $NOTIFY ]] || return 1
  timeout 0.5 sh -c 'printf "%s\n" "$1" > "$2"' sh "$1" "$NOTIFY" 2>/dev/null
}
need_daemon() { send "$1" || die "$cmd needs the kbd-rgb daemon running (sudo systemctl start kbd-rgb)"; }

hex() { [[ $1 =~ ^#?[0-9A-Fa-f]{6}$ ]] || die "bad color: $1"; echo "${1#\#}" | tr a-f A-F; }

# number VALUE OPTION MIN MAX RANGE-TEXT: VALUE must be a plain decimal from MIN to MAX
# (given in thousandths).
number() {
  [[ $1 =~ ^([0-9]{1,6})(\.([0-9]{1,6}))?$ ]] || die "bad $2: $1"
  local frac="${BASH_REMATCH[3]}000"
  local ms=$(( 10#${BASH_REMATCH[1]} * 1000 + 10#${frac:0:3} ))
  (( ms >= $3 && ms <= $4 )) || die "$2 must be $5"
}

cmd=${1:-status}
(( $# )) && shift
case $cmd in -h|--help|help) usage; exit 0 ;; esac
zone=- time=- dur=- args=()  # "-": not given
while (( $# )); do
  case $1 in
    -z|--zone) (( $# >= 2 )) || die "$1 needs a value"; zone=$2; shift 2 ;;
    -t|--time) (( $# >= 2 )) || die "$1 needs a value"; time=$2; shift 2 ;;
    -d|--for)  (( $# >= 2 )) || die "$1 needs a value"; dur=$2; shift 2 ;;
    --zone=*)  zone=${1#*=}; shift ;;
    --time=*)  time=${1#*=}; shift ;;
    --for=*)   dur=${1#*=}; shift ;;
    -h|--help) usage; exit 0 ;;
    --)        shift; args+=("$@"); break ;;
    -?*)       die "unknown option: $1" ;;
    *)         args+=("$1"); shift ;;
  esac
done

# takes OPTIONS MIN MAX WHAT: which options (z, t, d) and how many arguments cmd takes.
takes() {
  [[ $zone == - || $1 == *z* ]] || die "$cmd doesn't take --zone"
  [[ $time == - || $1 == *t* ]] || die "$cmd doesn't take --time"
  [[ $dur == - || $1 == *d* ]] || die "$cmd doesn't take --for"
  (( ${#args[@]} >= $2 && ${#args[@]} <= $3 )) || die "$cmd takes $4"
}
effect=0
case $cmd in cycle|rainbow|pulse) effect=1 ;; esac
case $zone in -|left|center|right|extra|all) ;; *) die "bad zone: $zone (left, center, right, extra, or all)" ;; esac
if [[ $time != - ]]; then
  if (( effect )); then number "$time" --time 100 60000 "from 0.1 to 60 seconds"
  else number "$time" --time 0 60000 "from 0 to 60 seconds"; fi
fi
[[ $dur == - ]] || number "$dur" --for 100 86400000 "from 0.1 to 86400 seconds"

# The options as daemon command words.
opts=""
[[ $zone == - ]] || opts+=" zone=$zone"
[[ $time == - ]] || opts+=" time=$time"
[[ $dur == - ]] || opts+=" for=$dur"

w() { printf '%s' "$2" > "$D/$1"; }

case $cmd in
  color)
    takes zt 1 1 "one color"; c=$(hex "${args[0]}")
    send "set$opts $c" && exit 0
    [[ $time == - ]] || die "--time needs the kbd-rgb daemon running (sudo systemctl start kbd-rgb)"
    if [[ $zone == - || $zone == all ]]; then zs=("${ZONE_NAMES[@]}"); else zs=("$zone"); fi
    for z in "${zs[@]}"; do w "color_$z" "$c"; done ;;
  zones)
    takes t 1 4 "1 to 4 colors (left, center, right, numpad; the rest are white)"; cs=()
    for i in 0 1 2 3; do c=$(hex "${args[$i]:-FFFFFF}"); cs+=("$c"); done
    lines=""
    for i in 0 1 2 3; do lines+="set zone=${ZONE_NAMES[$i]}$opts ${cs[$i]}"$'\n'; done
    send "${lines%$'\n'}" && exit 0
    [[ $time == - ]] || die "--time needs the kbd-rgb daemon running (sudo systemctl start kbd-rgb)"
    for i in 0 1 2 3; do w "color_${ZONE_NAMES[$i]}" "${cs[$i]}"; done ;;
  cycle)
    takes ztd 2 16 "2 to 16 colors"; cs=()
    for a in "${args[@]}"; do c=$(hex "$a"); cs+=("$c"); done
    need_daemon "cycle$opts ${cs[*]}" ;;
  rainbow)
    takes ztd 0 0 "no colors"
    need_daemon "rainbow$opts" ;;
  pulse)
    takes ztd 1 1 "one color"; c=$(hex "${args[0]}")
    need_daemon "pulse$opts $c" ;;
  brightness)
    takes "" 1 1 "a brightness from 0 to 255"
    [[ ${args[0]} =~ ^[0-9]{1,3}$ ]] && (( 10#${args[0]} <= 255 )) || die "brightness must be 0 to 255"
    w brightness "$(( 10#${args[0]} ))" ;;
  status)
    takes "" 0 0 "no arguments"
    for f in brightness "${ZONE_NAMES[@]/#/color_}"; do echo "$f: $(cat "$D/$f")"; done ;;
  *) usage >&2; exit 1 ;;
esac
